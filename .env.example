# Порт, который nginx публикует на хосте: http://localhost:8080
WEB_PORT=8080

# Модель в формате provider/model.
# ПУСТО = локальная mock-модель: всё работает без ключей (это дефолт).
# Примеры реальных моделей:
#   OPENCODE_MODEL=anthropic/claude-sonnet-4-5
#   OPENCODE_MODEL=google/gemini-3.8-flash
#   OPENCODE_MODEL=openrouter/google/gemma-4-31b-it:free
#   OPENCODE_MODEL=groq/llama-3.3-70b-versatile
OPENCODE_MODEL=

# Ключ провайдера: заполните тот, который используете.
# Для mock-модели ключи не нужны.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Дополнительно (дефолты подходят для запуска и приёмки) ---

# Требовать модель по умолчанию для 200 /health.
REQUIRE_MODEL=true

# RAG: адрес search-сервиса внутри сети Compose.
# VECTOR_DB_URL= (пустое значение) выключает RAG.
VECTOR_DB_URL=http://vector-db:8080
VECTOR_DB_COLLECTION=knowledge
VECTOR_DB_LIMIT=5

# Векторная база / загрузка документов при старте.
VECTOR_DIM=512
SEED_ON_START=true
QDRANT_API_KEY=

LOG_LEVEL=info
