# Port published by nginx on the host.
WEB_PORT=8080

# Model reference in OpenCode form: provider/model.
# Paid example:
#   OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# Free examples (see README):
#   GEMINI_API_KEY=...      OPENCODE_MODEL=google/gemini-3.8-flash
#   OPENROUTER_API_KEY=...  OPENCODE_MODEL=openrouter/google/gemma-4-31b-it:free
#   GROQ_API_KEY=...        OPENCODE_MODEL=groq/llama-3.3-70b-versatile
OPENCODE_MODEL=

# Optional default agent name.
OPENCODE_AGENT=

# Optional raw opencode.json content. If set, it replaces the generated config.
# OPENCODE_CONFIG_JSON={"$schema":"https://opencode.ai/config.json","model":"anthropic/claude-sonnet-4-5"}

# Require a default chat model before /health returns 200.
# Set to false only for infrastructure smoke tests without an LLM key.
REQUIRE_MODEL=true

# RAG service address inside the Compose network.
# Set VECTOR_DB_URL= (empty) to disable RAG and run without the vector database.
VECTOR_DB_URL=http://vector-db:8080
VECTOR_DB_COLLECTION=knowledge
VECTOR_DB_LIMIT=5

# Search service / Qdrant.
VECTOR_DIM=512
SEED_ON_START=true
QDRANT_API_KEY=

LOG_LEVEL=info

# Provider credentials. Fill in the one you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
