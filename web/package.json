{
  "name": "opencode-web-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web assistant built on the embedded OpenCode SDK",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "@opencode/sdk": "2.2.7",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
