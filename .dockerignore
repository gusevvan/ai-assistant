# Контекст сборки — весь репозиторий, но образу нужен только web/.
# Всё лишнее не отправляется демону Docker и не попадает в слои.

# VCS и CI
.git
.github

# Зависимости и артефакты сборки (ставятся/собираются внутри образа)
**/node_modules
**/dist
**/coverage
**/*.tsbuildinfo

# Секреты и локальные настройки — в образ не попадают никогда
**/.env
**/.env.*

# Другие сервисы (у них свои образы) и инфраструктура
vector-db/
mock-llm/
nginx/
scripts/
docs/
compose*.yaml

# Тесты и документация не нужны в runtime-образе
web/test/
**/README.md
**/*.log

# Служебные файлы
**/.gitignore
**/Dockerfile
**/.dockerignore
